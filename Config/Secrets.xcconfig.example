// Copy to Secrets.xcconfig and fill in real values.
// Secrets.xcconfig is gitignored — never commit real keys.
//
// Amplitude: dashboard → Settings → Projects → [your project] → API Key
// Sentry: sentry.io → Settings → Projects → [your project] → Client Keys (DSN)
// Sparkle: run ./bin/generate_keys from the Sparkle package to produce the key pair.
//          Store the private key in GitHub Secrets (SPARKLE_ED_PRIVATE_KEY).
//          Store the public key here AND in GitHub Variables (SPARKLE_ED_PUBLIC_KEY).
//
// NOTE: xcconfig treats "//" as a comment, so URLs with "https://" cannot be stored
// as full URLs. Store only the part after "https://" and let Info.plist reconstruct:
//   SENTRY_DSN_REMAINDER      → https://$(SENTRY_DSN_REMAINDER)
//   SPARKLE_APPCAST_URL_REMAINDER → https://$(SPARKLE_APPCAST_URL_REMAINDER)

AMPLITUDE_API_KEY = your_amplitude_api_key_here
SENTRY_DSN_REMAINDER = your_key@oXXXXXX.ingest.sentry.io/XXXXXXX
SPARKLE_APPCAST_URL_REMAINDER = truewebber.github.io/truerpc-mini/appcast.xml
SPARKLE_ED_PUBLIC_KEY = your_base64_ed25519_public_key_here
