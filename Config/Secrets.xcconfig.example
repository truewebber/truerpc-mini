// Copy to Secrets.xcconfig and fill in real values.
// Secrets.xcconfig is gitignored — never commit real keys.
//
// Amplitude: dashboard → Settings → Projects → [your project] → API Key
// Sentry: sentry.io → Settings → Projects → [your project] → Client Keys (DSN)

AMPLITUDE_API_KEY = your_amplitude_api_key_here
SENTRY_DSN = https://your_key@oXXXXXX.ingest.sentry.io/XXXXXXX
